{
  "name": "cpi-monitoring-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {"express": "^5.1.0", "express-rate-limit": "^8.1.0", "helmet": "^8.1.0", "react": "^19.1.0", "react-dom": "^19.1.0"},
  "devDependencies": {"concurrently": "^9.2.0", "vite": "^7.1.0"}
}
