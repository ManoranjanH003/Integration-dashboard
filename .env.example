# demo works with no SAP account; set sap when ready
DATA_MODE=demo
HOST=127.0.0.1
PORT=3001
# Full management API root; not the /http integration-flow endpoint
SAP_API_BASE_URL=https://your-management-host/api/v1/
# Exact tokenurl from the API-plan service key
SAP_TOKEN_URL=https://your-subaccount.authentication.region.hana.ondemand.com/oauth/token
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
# Shared server-side snapshot; browsers do not each poll SAP
POLL_INTERVAL_MS=30000
LOOKBACK_HOURS=24
MAX_MESSAGES=1000
MAX_PAGES=20
REQUEST_TIMEOUT_MS=15000
ERROR_CACHE_MS=60000
# Starter has no built-in user login. Local access only by default.
# To bind another address, first deploy an authenticated reverse proxy,
# restrict direct backend access, then explicitly acknowledge it here.
AUTH_PROXY_CONFIRMED=false
